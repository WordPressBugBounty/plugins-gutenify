{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "gutenify/wc-product-images-slider",
  "category": "gutenify",
  "title": "WooCommerce Product Images Slider",
  "version": "1",
  "usesContext": [
    "postType",
    "postId",
    "queryId"
  ],
  "attributes": {
    "blockClientId": {
      "type": "string",
      "default": ""
    },
    "blockAdvanceOptions": {
      "type": "object",
      "default": {
        "innerBlock": {}
      }
    },
    "productId": {
      "type": "number",
      "default": 0
    },
    "showFeaturedImage": {
      "type": "boolean",
      "default": true
    },
    "imageCount": {
      "type": "number",
      "default": 0
    },
    "aspectRatio": {
      "type": "string",
      "default": "auto"
    },
    "effect": {
      "type": "string",
      "default": "slide"
    },
    "slidesPerView": {
      "type": "number",
      "default": 1
    },
    "hasNavigation": {
      "type": "boolean",
      "default": true
    },
    "paginationType": {
      "type": "string",
      "default": "dots"
    },
    "isAutoplay": {
      "type": "boolean",
      "default": false
    },
    "autoplaySpeed": {
      "type": "number",
      "default": 3000
    },
    "autoplayOnHover": {
      "type": "boolean",
      "default": false
    },
    "loop": {
      "type": "boolean",
      "default": true
    },
    "spaceBetween": {
      "type": "number",
      "default": 10
    },
    "hasThumbnails": {
      "type": "boolean",
      "default": true
    },
    "thumbsPosition": {
      "type": "string",
      "default": "bottom"
    },
    "thumbsCount": {
      "type": "number",
      "default": 4
    },
    "thumbsSpaceBetween": {
      "type": "number",
      "default": 10
    },
    "thumbsHoverSwap": {
      "type": "boolean",
      "default": false
    },
    "hasKeyboardNav": {
      "type": "boolean",
      "default": false
    },
    "hasMousewheel": {
      "type": "boolean",
      "default": false
    },
    "isSticky": {
      "type": "boolean",
      "default": false
    },
    "stickyOffset": {
      "type": "number",
      "default": 20
    },
    "hasZoom": {
      "type": "boolean",
      "default": true
    },
    "hasLightbox": {
      "type": "boolean",
      "default": true
    },
    "linkToProduct": {
      "type": "boolean",
      "default": false
    },
    "hasVariationSync": {
      "type": "boolean",
      "default": true
    },
    "hasOverlay": {
      "type": "boolean",
      "default": false
    },
    "overlayOrientation": {
      "type": "string",
      "default": "row"
    },
    "overlayJustification": {
      "type": "string",
      "default": "center"
    },
    "overlayAlignment": {
      "type": "string",
      "default": "center"
    },
    "backgroundColor": {
      "type": "string",
      "default": ""
    },
    "backgroundGradient": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "align": true
  },
  "editorScript": [
    "gutenify-components",
    "file:./index.js"
  ],
  "editorStyle": [
    "file:./index.css"
  ],
  "style": [
    "file:./style-index.css",
    "gutenify-swiper"
  ],
  "script": [
    "gutenify-swiper"
  ],
  "viewScript": [
    "file:./view.js"
  ],
  "icon": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M3.4 8.3L3.4 15.7L0 12Z' fill='#2196f3' /><path d='M20.6 8.3L20.6 15.7L24 12Z' fill='#2196f3' /><path fill-rule='evenodd' clip-rule='evenodd' d='M5.5 3.5H18.5V20.5H5.5V3.5ZM6.9 4.9V19.1H17.1V4.9H6.9Z' fill='#2196f3' /><circle cx='9.3' cy='8.3' r='1.3' fill='#2196f3' /><path d='M7.2 16.3L10.6 11.1L12.5 13.4L15 10L16.8 16.3H7.2Z' fill='#2196f3' /></svg>"
}