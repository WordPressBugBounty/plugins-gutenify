{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "gutenify/popup",
  "title": "Popup",
  "description": "A trigger button that opens a popup with any blocks inside, for showing extra content without leaving the page.",
  "category": "gutenify",
  "version": "1",
  "attributes": {
    "blockClientId": {
      "type": "string",
      "default": ""
    },
    "buttonText": {
      "type": "string",
      "default": "Popup"
    },
    "placeholder": {
      "type": "string",
      "default": "Popup"
    },
    "hideButtonText": {
      "type": "boolean",
      "default": false
    },
    "blockAdvanceOptions": {
      "type": "object",
      "default": {
        "button": {
          "textColor": "",
          "backgroundColor": "",
          "backgroundGradient": "",
          "borderColor": "",
          "hoverTextColor": "",
          "hoverBackgroundColor": "",
          "hoverBackgroundGradient": "",
          "hoverBorderColor": "",
          "borderWidth": 0,
          "borderRadius": 4,
          "borderStyle": "solid",
          "padding": {
            "top": "10px",
            "right": "20px",
            "bottom": "10px",
            "left": "20px"
          },
          "width": "",
          "justify": "left"
        },
        "icon": {
          "name": "",
          "position": "left",
          "size": 20
        },
        "pulse": {
          "enabled": false,
          "color": "",
          "duration": 2,
          "size": 10
        }
      }
    },
    "closeOnBgClick": {
      "type": "boolean",
      "default": true
    },
    "showCloseBtn": {
      "type": "boolean",
      "default": true
    },
    "closeButtonColor": {
      "type": "string",
      "default": ""
    },
    "modalAnimation": {
      "type": "string",
      "default": "mfp-fade"
    },
    "modalCloseAnimation": {
      "type": "string",
      "default": ""
    },
    "modalAnimationSpeed": {
      "type": "number",
      "default": 0
    },
    "modalAnimationEasing": {
      "type": "string",
      "default": ""
    },
    "modalSize": {
      "type": "string",
      "default": "medium"
    },
    "modalCustomWidth": {
      "type": "number",
      "default": 800
    },
    "modalMinHeight": {
      "type": "string",
      "default": ""
    },
    "modalMaxHeight": {
      "type": "string",
      "default": ""
    },
    "modalPosition": {
      "type": "string",
      "default": "center"
    },
    "modalPositionMode": {
      "type": "string",
      "default": "viewport"
    },
    "modalPositionOffset": {
      "type": "number",
      "default": 60
    },
    "anchorSide": {
      "type": "string",
      "default": "bottom"
    },
    "anchorOffset": {
      "type": "number",
      "default": 8
    },
    "modalBorderRadius": {
      "type": "number",
      "default": 4
    },
    "modalShadow": {
      "type": "string",
      "default": "none"
    },
    "modalBackgroundColor": {
      "type": "string",
      "default": ""
    },
    "overlayColor": {
      "type": "string",
      "default": ""
    },
    "overlayOpacity": {
      "type": "number",
      "default": 0.8
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ]
  },
  "usesContext": [
    "postId"
  ],
  "editorScript": [
    "file:./index.js"
  ],
  "editorStyle": [
    "file:./index.css"
  ],
  "style": [
    "file:./style-index.css",
    "jquery-magnific-popup"
  ],
  "script": [
    "jquery-magnific-popup"
  ],
  "viewScript": [
    "file:./view-script.js"
  ],
  "icon": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill-rule='evenodd' clip-rule='evenodd' d='M12 5C6 5 2 12 2 12C2 12 6 19 12 19C18 19 22 12 22 12C22 12 18 5 12 5ZM12 15.5C10.067 15.5 8.5 13.933 8.5 12C8.5 10.067 10.067 8.5 12 8.5C13.933 8.5 15.5 10.067 15.5 12C15.5 13.933 13.933 15.5 12 15.5Z' fill='#2196f3' /><circle cx='12' cy='12' r='1.6' fill='#2196f3' /></svg>"
}